# Only needed when you're working inside a barrel-site-audit checkout — a global install keeps
# its own copy at ~/.barrel-audit/.env. Either way, `barrel-audit setup` writes and verifies this
# file for you; copying it by hand is the fallback, not the happy path.

# Required. The Vercel Blob store the CLI publishes reports to, which is what makes them appear on
# the dashboard. Vercel dashboard -> the barrel-site-audit project -> Storage -> the Blob store ->
# .env.local tab.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Enables the AI-written executive summary, the client-ready recommendations, the
# performance/accessibility suggestions and the theme architecture read. Those sections are
# skipped cleanly when it's unset; nothing else changes.
ANTHROPIC_API_KEY=

# Optional. Enables `barrel-audit link-repo` (and the inline "connect a GitHub repo?" prompt `run`
# shows for a brand-new store). Create a GitHub OAuth App once, for the whole team, at
# https://github.com/settings/developers -> New OAuth App, then enable "Device Flow" on it (in the
# app's settings page) and paste its Client ID below. No client secret needed — the CLI signs in
# per-user via a one-time code + browser approval, not a shared token.
GITHUB_OAUTH_CLIENT_ID=
