# --- Barrel Labs SSO ---------------------------------------------------------
# Login is delegated to Barrel Labs, which owns the Google sign-in and the per-app access list.
# This app needs no Google OAuth client and no user table of its own.
#
# One-time registration (a Labs admin, in Barrel Labs -> Control -> Experiments):
#   Slug                = site-audit          (the token audience; changing it breaks deployments)
#   SSO redirect hosts  = barrel-site-audit.vercel.app, localhost:3000
#                         (exact hosts, no wildcards — empty means SSO is refused)
#   Access              = OPEN or RESTRICTED, as you want it
# Privacy Compliance is additionally limited to people whose Labs role is admin.

LABS_URL=https://barrel-labs.vercel.app
LABS_APP_SLUG=site-audit

# Signs THIS app's session cookie. Not shared with Labs, not shared with any other app.
#   openssl rand -base64 32
LABS_SESSION_SECRET=replace-with-a-long-random-string

# Optional — overrides the origin used to build the SSO redirect_uri. Normally derived from
# VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL, falling back to localhost:3000. Whatever this
# resolves to must be one of the registered SSO redirect hosts above, port included.
# LABS_APP_ORIGIN=http://localhost:3000

# --- Everything else ---------------------------------------------------------
# Signs the public client-report share links (`/share/<token>`). Nothing to do with login —
# a share link is deliberately readable with no session at all.
#   openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# Same Vercel Blob store the CLI uploads reports to (see the repo-root .env.example).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
